#!/bin/sh
# Prepare a fresh checkout (a new worktree or clone):
#  1. fast-forward a branch with no commits of its own to the server's origin/dev,
#     so it never starts from a stale local ref;
#  2. give it the media submodule the compile needs, from the shared local cache
#     (.github/scripts/ensure-media-submodule.sh). Second, so it sees the pin the
#     fast-forward landed on.
#
# Enable once per clone:  git config core.hooksPath .githooks
# Opt out for one checkout by setting NAX_NO_DEV_SYNC=1 and/or
# NAX_NO_MEDIA_SUBMODULE=1 around the `git worktree add`:
#   sh:          NAX_NO_DEV_SYNC=1 git worktree add ...
#   PowerShell:  $env:NAX_NO_DEV_SYNC='1'; git worktree add ...; Remove-Item Env:NAX_NO_DEV_SYNC

# $1 is the all-zero object id only on the initial checkout; branch switches are left alone.
case "$1" in
  *[!0]*) exit 0 ;;
esac

# Step 1 never fails the checkout: offline, a hung remote or a diverged branch
# just leaves the branch where it is and says so on stderr. A branch that already
# has commits (HEAD not an ancestor of origin/dev) is never moved; a detached
# HEAD is a deliberate pin and is left alone.
if [ "${NAX_NO_DEV_SYNC:-}" = "1" ]; then
  echo "post-checkout: NAX_NO_DEV_SYNC=1; not syncing with origin/dev." >&2
elif ! git symbolic-ref -q HEAD >/dev/null; then
  echo "post-checkout: detached HEAD; not syncing with origin/dev." >&2
else
  export GIT_TERMINAL_PROMPT=0
  if command -v timeout >/dev/null 2>&1; then
    timeout 60 git fetch --quiet origin dev
  else
    git fetch --quiet origin dev
  fi
  if [ $? -ne 0 ]; then
    echo "post-checkout: could not fetch origin/dev; this branch may start behind the server ('git fetch origin dev', then 'git log HEAD..origin/dev')." >&2
  elif ! git merge-base --is-ancestor HEAD refs/remotes/origin/dev; then
    echo "post-checkout: branch has commits that are not on origin/dev; left where it is." >&2
  else
    git merge --quiet --ff-only refs/remotes/origin/dev >/dev/null 2>&1 \
      && echo "post-checkout: at origin/dev ($(git rev-parse --short HEAD))." >&2 \
      || echo "post-checkout: could not fast-forward to origin/dev; run 'git merge --ff-only origin/dev'." >&2
  fi
fi

# Codex reads skills only from .agents/skills. Link it to .claude/skills so
# every tool reads one copy; a copy goes stale. A junction on Windows, since it
# needs no admin or Developer Mode, a symlink elsewhere. A copy or a dangling
# link already there is reported, never deleted: it may hold work.
top="$(git rev-parse --show-toplevel)"
link="$top/.agents/skills"
if [ ! -d "$top/.claude/skills" ]; then
  :
elif [ -L "$link" ]; then
  [ -e "$link" ] || echo "post-checkout: .agents/skills is a dangling link; delete it and check out again so Codex sees the skills." >&2
elif [ -e "$link" ]; then
  echo "post-checkout: .agents/skills is a copy, not a link to .claude/skills, so Codex reads stale skills. Move it away and check out again." >&2
else
  mkdir -p "$top/.agents"
  case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*)
      MSYS_NO_PATHCONV=1 cmd /c mklink /J "$(cygpath -w "$link")" "$(cygpath -w "$top/.claude/skills")" >/dev/null ;;
    *) ln -s ../.claude/skills "$link" ;;
  esac || echo "post-checkout: could not link .agents/skills; Codex will not see the skills." >&2
fi

[ "${NAX_NO_MEDIA_SUBMODULE:-}" = "1" ] && exit 0

script="$(git rev-parse --show-toplevel)/.github/scripts/ensure-media-submodule.sh"
[ -f "$script" ] || exit 0
sh "$script" || echo "post-checkout: media submodule not set up; the compile fails until 'sh .github/scripts/ensure-media-submodule.sh' succeeds." >&2
exit 0
