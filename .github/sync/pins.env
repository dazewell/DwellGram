# Pinned invariants for the snapshot-mediated nbase sync guard.
#
# Every value here is a measured fact about dev at the anchor, not a preference.
# sync-guard.ps1 reads this file from the TRUSTED PRE (dev) checkout, never from
# an incoming candidate. Changing a pin is a deliberate act that belongs in its
# own reviewed commit, never something a sync run may do.
#
# Layer floors describe the compatibility baseline DwellGram carries across parent
# changes. They are invariants of this fork, not paths expected to exist in the
# Telegram source tree. Where recorded, measured history stays at the individual
# pin lines; otherwise the value itself is the reviewed floor.
# KEY=VALUE, '#' comments, blank lines ignored.

# --- Upstream source (guard 1: hardcoded, no branch input) ---
# NAGRAM_* and the internal `nagram` remote are temporary legacy identifiers.
# Their values, not their names, are authoritative for the current source.
NAGRAM_REPO=https://github.com/DrKLO/Telegram.git
NAGRAM_BRANCH=master

# --- Snapshot workflow policy (guard 5) ---
# Telegram has no .github/workflows paths. `none` requires the manifest to contain
# only its header and rejects any workflow path in a source snapshot.
WORKFLOW_POLICY=none

# --- Anchor currently recorded (guard 3: a new source must descend from this) ---
# Telegram master 62b56a07 and the locally-authored snapshot e5cc4221 carry
# byte-identical trees. The attended re-anchor procedure is owned by README.md.
ANCHOR_SRC=62b56a07ca7e30e39f7fd00a6728d6bbd716ca1c
OLD_NBASE=e5cc4221decd4c1e12f3a0eef3602ec304372c2b
OLD_NBASE_TREE=b406defb637ed56d392f1b934507221b8243822c

# --- Snapshot author identity (guard: land-check) ---
# The locally-authored snapshot a sync mints carries this identity in BOTH its
# author and committer fields — sync-upstream.yml sets GIT_AUTHOR_*/GIT_COMMITTER_*
# and git config user.* to exactly this pair. sync-land reads it here (single source
# of truth, from the trusted PRE) and asserts a reconciliation snapshot it is about
# to fast-forward nbase onto was authored AND committed by this identity, so a
# snapshot that smuggled in an upstream author is rejected before nbase moves. These
# must stay equal to the literals in sync-upstream.yml; a mismatch would make every
# real sync snapshot fail the land check.
SYNC_IDENTITY_NAME=dazegram-sync
SYNC_IDENTITY_EMAIL=sync@dazegram.local

# --- Signing identity (guard 13) ---
KEYSTORE_PATH=TMessagesProj/release.keystore
KEYSTORE_BLOB=05b4f3a6324c65c8c6abdc5b81c3bd5ae5cfc280
# DER SHA-256 of the certificate the release alias exports. Proven on the runner
# with keytool -exportcert -storepass:env, never from the blob alone: a different
# key with the same on-disk path builds and signs a perfectly valid APK that no
# existing user can install over.
KEYSTORE_CERT_SHA256=4056b5df0c20584651eeaf7095a8ef5aa473024d8a22577e89f085a8ef3a244c
# Subject CN the exported certificate must carry. SHA-256 alone proves the bytes;
# the subject proves whose key it is. Checked together on the runner.
KEYSTORE_SUBJECT_CN=Dmitriy Babenko
SIGNING_GRADLE_PATH=TMessagesProj/build.gradle
SIGNING_GRADLE_BLOB=8bb49c7002ae849851400cf0469fdee7069ac500

# --- Submodule / vendored-tree integrity (guard 10) ---
# The .gitmodules blob is frozen, and every vendored native must keep the exact git
# object shape recorded here. This is table-driven: VENDORED_NATIVES lists the entry
# names, and each name <N> carries <N>_PATH, <N>_MODE, <N>_TYPE, plus <N>_COMMIT for
# a gitlink. Add the next component by adding a name and its lines — no code edit.
#   MODE 040000 TYPE tree   = vendored in-tree source; the tree object sha varies per
#                             upstream bump and is deliberately NOT pinned.
#   MODE 160000 TYPE commit = an intentional submodule; its <N>_COMMIT must match the
#                             recorded gitlink exactly.
# Why every native and not just boringssl: the 12.10.1 default merge silently turned
# libyuv and openh264 from vendored trees (040000) into submodule gitlinks (160000),
# 82 and 288 files vanishing with no conflict marker. Pinning boringssl alone let
# that through, so every vendored entry is pinned now.
GITMODULES_BLOB=204b122fdb489121fb5c2bfd4166eaad2b2c7bfe
VENDORED_NATIVES=BORINGSSL,LIBYUV,OPENH264,TLOTTIE,MEDIA
BORINGSSL_PATH=TMessagesProj/jni/third_party/boringssl
BORINGSSL_MODE=160000
BORINGSSL_TYPE=commit
BORINGSSL_COMMIT=2b44a3701a4788e1ef866ddc7f143060a3d196c9
LIBYUV_PATH=TMessagesProj/jni/third_party/libyuv
LIBYUV_MODE=040000
LIBYUV_TYPE=tree
OPENH264_PATH=TMessagesProj/jni/third_party/openh264
OPENH264_MODE=040000
OPENH264_TYPE=tree
TLOTTIE_PATH=TMessagesProj/jni/tlottie
TLOTTIE_MODE=160000
TLOTTIE_TYPE=commit
TLOTTIE_COMMIT=92df98dc209bc39b1e567ec74a8c86a0af5239de
MEDIA_PATH=TMessagesProj_Modules/media
MEDIA_MODE=160000
MEDIA_TYPE=commit
MEDIA_COMMIT=c430d207677071b1873f9f18266d55ec45722180

# --- Fork layer floors (guard 11) ---
# Counts under fork-owned packages and surfaces carried by DwellGram. Telegram is
# not expected to contain these paths; a sync that drops them still blocks.
NEKOMIMI_PATH=TMessagesProj/src/main/java/tw/nekomimi/
# Lowered 172 -> 161: the 11 fork-written tw/nekomimi files moved to com/dazewell/gram (DwellGram rebrand).
NEKOMIMI_MIN=161
RADOLYN_PATH=TMessagesProj/src/main/java/com/radolyn/
# com/radolyn now holds only the inherited AyuGram files (27). Every file this fork wrote moved to
# com/dazewell/gram in the DwellGram rebrand, so this count no longer grows with features.
RADOLYN_EXACT=27
# Fork-written code (DwellGram rebrand). Exact like RADOLYN_EXACT: a feature that adds a class here
# bumps this in the same PR; each bump gets a one-line note below.
DAZEWELL_PATH=TMessagesProj/src/main/java/com/dazewell/gram/
# Bumped 96 -> 97: the text memo picks, copies and sends media from its own class (#text-memo-photos).
# Bumped 97 -> 99: the notification profile controller and its picker sheet (#notification-profiles).
# Bumped 99 -> 100: the chat header menu entry for the notification profile (#notification-profiles).
# Bumped 100 -> 103: chat button layout, its per-chat controller and its editor (#chat-menu-order).
# Bumped 103 -> 105: the notification schedule rules and their editor dialog (#notification-profiles).
# Bumped 105 -> 106: the memo entries for apps that list exported activities (#memo-shortcut-picker).
# Bumped 106 -> 107: the timed profile dialog (#notif-profile-timer).
# Bumped 107 -> 108: the memo recipient's online state and unread count (#memo-recipient-status).
# Bumped 108 -> 110: the scheduled selection's pick order and the Reschedule Order row (#reschedule-order).
# Bumped 110 -> 111: the scheduled header's unread pill (#scheduled-header-unread).
DAZEWELL_EXACT=111
STRINGS_NAX_PATH=TMessagesProj/src/main/res/values/strings_nax.xml
# Bumped 599 -> 710: re-measures a pre-existing drifted floor (599 was the pinned
# floor vs ~696 actual before any feature work) plus the trigger-sheet presets
# feature's 14-string addition (#eventschedule).
# Bumped 710 -> 726: adds the Ghost Hold feature's 16 user-facing strings
# (#ghost-hold). This floor now holds at exactly the current count with zero slack;
# any future legitimate string removal will trip the sync guard and require a
# deliberate pins.env edit.
# Bumped 726 -> 817: re-measures the floor, which had drifted to 793 on dev, plus the header
# background feature's 24 strings (#header-avatar-bg). Again zero slack.
# Bumped 817 -> 819: the header background panel switch (#header-avatar-bg).
# Bumped 819 -> 828: the hidden chat-list preview's mode labels and descriptions (#hide-last-message).
# Bumped 828 -> 838: the header background gradient's range and curve, blur and desaturate (#header-avatar-bg).
# Bumped 838 -> 842: the header background's Alternate color setting and its three values (#header-avatar-bg).
# Bumped 842 -> 843: the Interface Style page's Title and decoration section header (#interface-style).
# Bumped 843 -> 848: the text memo shortcut's switch, notice, label, hint and the Memos header (#text-memo-shortcut).
# Bumped 848 -> 850: the header background text colour rows replace Alternate color (#header-avatar-bg).
# Bumped 850 -> 860: re-measures the floor, which had drifted to 858, plus the text memo's media strings (#text-memo-photos).
# Bumped 860 -> 870: the per-chat notification profile row, presets and channel names (#notification-profiles).
# Lowered 870 -> 867: the disguise cover drops its persona channel names and the covered-chat profile toast (#disguise-parity).
# Bumped 867 -> 868: the chat menu's Alerts item label (#notification-profiles).
# Bumped 868 -> 869: the Alerts bell's switch label (#notification-profiles).
# Bumped 869 -> 875: the chat menu editor's sections, footers, reset toast and Alerts title, less the retired bell label (#chat-menu-order).
# Bumped 875 -> 883: the notification schedule row, editor labels and the scheduled Alerts label (#notification-profiles).
# Lowered 883 -> 878: the hardware smooth zoom row, notice and its three bulletins are gone (#chore).
# Bumped 878 -> 883: Until, the for… title, active/cancel and the Alerts until label (#notif-profile-timer).
# Bumped 883 -> 897: the header background scrim's section, and the Top and bottom and Center directions (#header-avatar-bg).
# Bumped 897 -> 898: the join for the memo recipient's online state and unread count (#memo-recipient-status).
# Bumped 898 -> 899: the short hold-to-send hint once it has been learned (#video-hold-send).
# Bumped 899 -> 905: the Reschedule Order row, its picker title and two options with descriptions (#reschedule-order).
STRINGS_NAX_MIN=905
NACONFIG_PATH=TMessagesProj/src/main/kotlin/xyz/nextalone/nagram/NaConfig.kt
NACONFIG_ADDCONFIG_MIN=262

# --- AyuGram schema (guard 12) ---
AYU_DB_PATH=TMessagesProj/src/main/java/com/radolyn/ayugram/database/AyuDatabase.java
AYU_DATA_PATH=TMessagesProj/src/main/java/com/radolyn/ayugram/database/AyuData.java
AYU_VERSION=27
AYU_MIN_VERSION=21
AYU_ENTITIES=4

# --- Executable Gradle build surface (guard 11 extension) ---
# These run on the CI runner (buildSrc at configuration time; distributionUrl
# picks the Gradle binary the runner downloads) while it holds LOCAL_PROPERTIES
# and the bot token. Only TMessagesProj/build.gradle is blob-pinned; the rest are
# asserted to stay in the fork delta so an upstream-only change to them always
# lands in the double-modified intersection and blocks. A trailing '/' means a
# prefix (every file under it must diverge). Membership, not blob-pinning — a fork
# PR that edits build.gradle is unaffected. gradle.properties is here too: it
# carries APP_PACKAGE and the APK version inputs, and it sits in neither
# protected-paths.tsv nor a blob pin, so without this an upstream-only edit to it
# would auto-apply unchecked.
GRADLE_SURFACE=build.gradle,settings.gradle,gradle/wrapper/gradle-wrapper.properties,gradlew,gradlew.bat,buildSrc/,gradle.properties

# --- Files the guard protects from any candidate edit (structural) ---
# The guard and the workflows that invoke it must be byte-identical to PRE in the
# candidate, so an incoming snapshot can never rewrite the thing that inspects it.
# sync-land.yml is here too: it holds SYNC_TOKEN (the repo's most powerful
# credential) and moves nbase, so an incoming snapshot must never be able to rewrite
# it either. (SELF_PROTECT binds an incoming candidate only; a fork-authored PR may
# still edit these files under review, which is how this line itself was added.)
SELF_PROTECT=.github/sync/sync-guard.ps1,.github/sync/pins.env,.github/sync/protected-paths.tsv,.github/sync/workflow-manifest.tsv,.github/workflows/sync-upstream.yml,.github/workflows/sync-guard-check.yml,.github/workflows/sync-land.yml
